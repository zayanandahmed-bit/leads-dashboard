# Copy to .env and fill in. .env is gitignored — never commit it, and never
# paste these values into the dashboard or into a chat.

# Twilio Console > Account > General settings
ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AUTH_TOKEN=your_auth_token_used_only_for_deploying

# Twilio Console > Account > API keys & tokens > Create API key (Standard)
API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
API_SECRET=your_api_key_secret

# Twilio Console > Voice > TwiML Apps (Voice URL = https://<your-service>.twil.io/voice)
TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The UK number you bought on Twilio, E.164 format. Shown as caller ID.
CALLER_ID=+442071234567

# Long random string. You type this into the dashboard's Call system settings.
# Generate one with:  openssl rand -base64 24
CALL_PASSCODE=

# Where the dashboard is hosted. Add http://localhost:8765 while testing locally.
ALLOWED_ORIGINS=https://zayanandahmed-bit.github.io

# Countries the dialer may call. +44 = UK only. Add ,+1 for US, ,+971 for UAE.
ALLOWED_PREFIXES=+44

# Recording. Whoever records, YOU tell the other person at the start of the
# call; the dashboard shows a reminder while the call is live.
#   true / twilio  Twilio records the call (default). Stored in your Twilio
#                  account; the dashboard can play calls up to about 8 minutes.
#   browser        The dashboard records the call and saves a copy to a private
#                  Supabase bucket, so it plays in any browser with your
#                  passcode. No length limit, no Twilio fee.
#   false          No recording.
RECORD_CALLS=browser
# Optional. Leave unset (recommended if you say it yourselves). If set, a
# recorded voice plays this to the person you call before you connect.
# RECORDING_NOTICE=This call is being recorded for training and quality purposes.

# Leave AGENTS unset: everyone shares ONE login (the same passcode), so you can
# open the dashboard in two browsers and an incoming call rings both; the first
# to answer takes it. Only set this if you ever want separate named logins:
# AGENTS=zayan,ahmed

# SECRET. Supabase > Project Settings > API > "service_role" key. Only this
# backend ever holds it: it is what lets /recording-url open the private
# recordings bucket. Never put it in the dashboard or paste it into a chat.
SUPABASE_SERVICE_KEY=

# Lets missed inbound calls be written to the shared call log. Both are the
# same public values already in the dashboard page.
SUPABASE_URL=https://ajevxwdgmpaakjkffvmf.supabase.co
SUPABASE_ANON_KEY=
