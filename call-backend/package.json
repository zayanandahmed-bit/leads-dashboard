{
  "name": "signalboard-call-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Twilio Functions backend for the Signal Board browser dialer: token minting + outbound call TwiML.",
  "scripts": {
    "start": "twilio-run --env .env",
    "deploy": "twilio-run deploy --env .env --service-name signalboard-calls --runtime node22"
  },
  "dependencies": {
    "@twilio/runtime-handler": "2.1.0",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "twilio-run": "^5.0.1"
  },
  "engines": {
    "node": "22"
  }
}
